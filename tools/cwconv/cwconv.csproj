<Project Sdk="Microsoft.NET.Sdk">
  <!-- CodeWalker XML <-> GTA V binary (.ydr/.ytd) converter built on CodeWalker.Core.
       dotnet build tools/cwconv -c Release -o build/cwconv -p:CodeWalkerDir=<CodeWalker checkout> -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <CodeWalkerDir Condition="'$(CodeWalkerDir)' == ''">$(MSBuildThisFileDirectory)../../build/CodeWalker</CodeWalkerDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CodeWalkerDir)/CodeWalker.Core/CodeWalker.Core.csproj" />
  </ItemGroup>
</Project>
