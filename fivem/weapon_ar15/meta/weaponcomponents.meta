<?xml version="1.0" encoding="UTF-8"?>
<!--
  Components of WEAPON_AR15. Every component model has its origin (and an AAP* bone) exactly on the
  weapon attach bone it uses, so no offsets are needed:
    WAPClip      COMPONENT_AR15_CLIP_01    magazine (default)
    WAPScop      COMPONENT_AR15_SIGHTS     flip-up iron sights, raised (default)
                 COMPONENT_AT_AR15_HOLO    holographic sight + the iron sights folded down
                                           (same attach point, so fitting it replaces the raised sights)
    WAPGrip      COMPONENT_AT_AR15_AFGRIP  angled foregrip
    WAPFlshLasr  COMPONENT_AT_AR15_FLSH    weapon light; its origin is the lens centre
    WAPSupp_2    COMPONENT_AT_AR15_LASER   laser module; its origin is the emitter (the beam is drawn by client.lua)
-->
<CWeaponComponentInfoBlob>
  <Infos>
    <Item type="CWeaponComponentClipInfo">
